# YoguraSo - variables del FRONTEND (Vite)
# Copia este archivo a .env y reemplaza los valores. El archivo .env NO se sube a Git.
#
# Solo van aquí valores PÚBLICOS. Nunca pongas la clave service_role en este archivo,
# ni en ninguna variable que empiece por VITE_: todo lo que empieza así queda visible
# en el navegador de cualquier persona.

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase > Project Settings > API > clave pública (publishable / anon)
VITE_SUPABASE_ANON_KEY=TU-CLAVE-PUBLICA

# Número de WhatsApp para pedidos: código de país + número, sin + ni espacios.
# Hoy el sitio usa un número de prueba (frontend/js/config.js).
VITE_WHATSAPP_NUMBER=57XXXXXXXXXX

# Dirección pública del sitio (sitemap, Open Graph, canonical)
VITE_SITE_URL=https://tu-dominio.com

# --- SOLO para Edge Functions (se guardan con `supabase secrets set`, NO en este archivo) ---
# SUPABASE_SERVICE_ROLE_KEY
